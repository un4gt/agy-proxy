{
  "$schema": "https://opencode.ai/config.json",
  "model": "agy/gemini-3.8-flash-low",
  "enabled_providers": ["agy"],
  "provider": {
    "agy": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "models": {
        "gemini-3.8-flash-low": {
          "name": "AGY Gemini Flash Low",
          "limit": {"context": 200000, "output": 8192}
        }
      }
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "C:\\Users\\MT308\\AppData\\Roaming\\fnm\\aliases\\default\\npx.cmd",
        "-y", "@modelcontextprotocol/server-filesystem", "E:\\mcp-workspace"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "oauth": false,
      "headers": {"Authorization": "Bearer {env:EXA_API_KEY}"},
      "enabled": true,
      "timeout": 30000
    }
  }
}
