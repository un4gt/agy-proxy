# Python-generated files
__pycache__/
*.pyc[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / local deployment config
.env
.test.env
.codex/

# Local runtime data (API keys + usage) and preview artifacts
.devdata/
.preview/
/bin/
/.pytest_cache/
/.ruff_cache/
/test_sessions/

# Frontend build chain: installed packages never go in the repo.
# NOTE: app/static/app.css is deliberately NOT ignored — it is a compiled
# artifact and IS committed, so running the app never needs Node.
node_modules/
npm-debug.log*
app/static/*.css.map

# Private integration notes stay local
/docs/mcp.md
/docs/vision.md
/docs/skills.md
