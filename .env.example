# ================= agy-proxy 配置 =================
# 复制为 .env 后修改；公网部署至少填 AGY_PROXY_PASSWORD

# 对外端口（宿主机侧）
PORT=8317

# 【必填·公网部署】控制台密码，用于登录面板（/signin）。
# 它只保护本服务的页面与管理接口，不是给客户端调 API 用的。
# 生成一把随机密码：openssl rand -hex 32
AGY_PROXY_PASSWORD=

# 固定 API 密钥（可选，逗号分隔）。上游客户端调 /v1/* 用它，也兼作面板登录凭证。
# 常规做法是留空，改在控制台「API Keys」里按需创建/吊销。
# 若未设置 AGY_PROXY_PASSWORD，这里的第一把密钥会作为面板密码的兜底（启动会打 WARNING）。
AGY_PROXY_API_KEYS=

# 账号详情刷新过期 OAuth 凭据时使用；必须匹配签发该凭据的 CLI OAuth 客户端。
# 通过本地 .env 或部署密钥注入，不要提交真实值。未配置时仍可使用未过期凭据。
AGY_PROXY_OAUTH_CLIENT_ID=
AGY_PROXY_OAUTH_CLIENT_SECRET=

# 数据目录（API Key 与用量记录，data.json）。Docker 里挂到 volume 才不会丢。
# 默认 ~/.agy-proxy
AGY_PROXY_DATA_DIR=

# 出站代理：服务器需要代理才能访问 Google 时填，如 http://host.docker.internal:7890
# （宿主机上的 Clash 等需监听 0.0.0.0 或允许局域网连接）
AGY_PROXY_HTTP_PROXY=

# 预热模型（可选，逗号分隔，如 gemini-3.1-pro-high）
# 每个模型常备一个空闲会话，消除新会话约 6 秒的 agy 冷启动
AGY_PROXY_PREWARM_MODELS=

# 并发 agy 进程上限（LRU 淘汰）
AGY_PROXY_MAX_SESSIONS=8

# 单轮对话总超时（秒）
AGY_PROXY_TURN_TIMEOUT=600

# `agy models` 列表缓存秒数
AGY_PROXY_MODELS_TTL=300
